{
  "Route GET": {
    "prefix": "rute:get",
    "body": [
      "rute.get(\"${1:/}\", gawe(req, res)",
      "    balekna ${2:res.view(\"index\", [\"judul\": \"LarapakGo\"])}",
      "rampung)"
    ],
    "description": "Ngawe rute HTTP GET neng NgapakIn"
  },
  "Route POST": {
    "prefix": "rute:post",
    "body": [
      "rute.post(\"${1:/api/simpen}\", gawe(req, res)",
      "    balekna ${2:res.json([\"status\": \"sukses\"])}",
      "rampung)"
    ],
    "description": "Ngawe rute HTTP POST neng NgapakIn"
  },
  "Fungsi Gawe": {
    "prefix": "gawe",
    "body": [
      "gawe ${1:jenengFungsi}(${2:param})",
      "    ${0}",
      "    balekna ${3:bener}",
      "rampung"
    ],
    "description": "Deklarasi fungsi NgapakIn"
  },
  "Kondisi Nek": {
    "prefix": "nek",
    "body": [
      "nek ${1:kondisi} ya",
      "    ${0}",
      "rampung"
    ],
    "description": "Blok percabangan nek ... ya"
  },
  "Kondisi Nek Liyane": {
    "prefix": "nek:liyane",
    "body": [
      "nek ${1:kondisi} ya",
      "    ${2}",
      "liyane",
      "    ${0}",
      "rampung"
    ],
    "description": "Blok percabangan nek ... ya ... liyane"
  },
  "Perulangan Baleni Range": {
    "prefix": "baleni:range",
    "body": [
      "baleni ${1:i} saka ${2:1} nganti ${3:10}",
      "    ${0}",
      "rampung"
    ],
    "description": "Perulangan baleni saka ... nganti"
  },
  "Perulangan Baleni Koleksi": {
    "prefix": "baleni:neng",
    "body": [
      "baleni ${1:item} neng ${2:daftar}",
      "    ${0}",
      "rampung"
    ],
    "description": "Perulangan baleni ... neng koleksi"
  },
  "Database Query Select": {
    "prefix": "db:select",
    "body": [
      "db.tabel(\"${1:users}\").pilih(${2:\"id\", \"jeneng\"}).neng(\"${3:status}\", \"=\", \"${4:aktif}\").jupuk()"
    ],
    "description": "Query database fluent SELECT neng NgapakIn"
  },
  "Database Query Insert": {
    "prefix": "db:insert",
    "body": [
      "db.tabel(\"${1:users}\").tambah([\"${2:jeneng}\": \"${3:Slamet}\"])"
    ],
    "description": "Query database fluent INSERT neng NgapakIn"
  },
  "Komponen RikatLive": {
    "prefix": "urip:komponen",
    "body": [
      "# Komponen RikatLive ${1:Counter}",
      "${2:count} = 0",
      "${3:jeneng} = \"Pengguna\"",
      "",
      "gawe ${4:tambah}(step)",
      "    nek step == kosong ya",
      "        step = 1",
      "    rampung",
      "    ${2:count} = ${2:count} + step",
      "rampung"
    ],
    "description": "Template skrip komponen reaktif RikatLive (.ngpk)"
  }
}

