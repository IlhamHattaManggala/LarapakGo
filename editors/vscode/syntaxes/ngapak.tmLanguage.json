{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NgapakIn",
  "scopeName": "source.ngpk",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#framework"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ngpk",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ngpk",
          "match": "\\b(nek|ya|liyane|rampung|baleni|saka|nganti|gawe|balekna|kelas|extends|mandeg|terusna)\\b"
        },
        {
          "name": "keyword.operator.logical.ngpk",
          "match": "\\b(lan|utawa|ora|neng)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ngpk",
          "match": "\\b(bener|salah)\\b"
        },
        {
          "name": "constant.language.null.ngpk",
          "match": "\\b(kosong)\\b"
        }
      ]
    },
    "framework": {
      "patterns": [
        {
          "name": "support.class.larapak.ngpk",
          "match": "\\b(rute|req|res)\\b"
        },
        {
          "name": "support.function.builtin.ngpk",
          "match": "\\b(tulis|panjang)\\b"
        },
        {
          "name": "support.function.route.ngpk",
          "match": "(?<=\\.)(get|post|put|delete|patch|view|json|string|html|status|params|query|method|body)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ngpk",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ngpk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ngpk",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ngpk",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ngpk",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.ngpk",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ngpk",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ngpk",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ngpk",
          "match": "(\\+|-|\\*|/)"
        }
      ]
    }
  }
}
